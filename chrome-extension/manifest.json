{
  "manifest_version": 3,
  "name": "ChatSavor",
  "version": "2.0.0",
  "description": "Extract and save AI responses as Markdown, PDF, or Word with real-time preview",
  "permissions": ["activeTab"],
  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://deepseek.com/*",
    "*://*.deepseek.com/*",
    "*://*.google.com/*",
    "*://*.baidu.com/*",
    "*://doubao.com/*",
    "*://*.doubao.com/*",
    "*://chatglm.cn/*",
    "*://*.chatglm.cn/*",
    "*://tongyi.aliyun.com/*",
    "*://*.tongyi.aliyun.com/*",
    "*://qwen.ai/*",
    "*://*.qwen.ai/*",
    "*://kimi.com/*",
    "*://*.kimi.com/*",
    "*://kimi.moonshot.cn/*",
    "*://*.kimi.moonshot.cn/*",
    "*://yuanbao.tencent.com/*",
    "*://*.yuanbao.tencent.com/*",
    "*://grok.com/*",
    "*://*.grok.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://xfyun.cn/*",
    "*://tiangong.cn/*",
    "*://ai.360.cn/*",
    "*://poe.com/*",
    "*://coze.cn/*",
    "*://coze.com/*",
    "*://perplexity.ai/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://*.google.com/*",
        "*://*.baidu.com/*",
        "*://doubao.com/*",
        "*://*.doubao.com/*",
        "*://chatglm.cn/*",
        "*://*.chatglm.cn/*",
        "*://tongyi.aliyun.com/*",
        "*://*.tongyi.aliyun.com/*",
        "*://qwen.ai/*",
        "*://*.qwen.ai/*",
        "*://kimi.com/*",
        "*://*.kimi.com/*",
        "*://kimi.moonshot.cn/*",
        "*://*.kimi.moonshot.cn/*",
        "*://yuanbao.tencent.com/*",
        "*://*.yuanbao.tencent.com/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://xfyun.cn/*",
        "*://tiangong.cn/*",
        "*://ai.360.cn/*",
        "*://poe.com/*",
        "*://coze.cn/*",
        "*://coze.com/*",
        "*://perplexity.ai/*"
      ],
      "js": [
        "src/lib/pdf.js",
        "src/lib/turndown.js",
        "src/lib/marked.js",
        "src/content/core.js",
        "src/content/content.js",
        "src/content/platforms/chatgpt.js",
        "src/content/platforms/gemini.js",
        "src/content/platforms/doubao.js",
        "src/content/platforms/kimi.js",
        "src/content/platforms/chatglm.js",
        "src/content/platforms/tongyi.js",
        "src/content/platforms/qwen.js",
        "src/content/platforms/yuanbao.js",
        "src/content/platforms/grok.js",
        "src/content/platforms/deepseek.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
