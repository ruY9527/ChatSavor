{
  "manifest_version": 3,
  "name": "ChatSavor",
  "version": "2.0.6",
  "description": "Extract and save AI responses as Markdown, PDF, or Word with real-time preview",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://doubao.com/*",
    "https://*.doubao.com/*",
    "https://chatglm.cn/*",
    "https://*.chatglm.cn/*",
    "https://tongyi.aliyun.com/*",
    "https://*.tongyi.aliyun.com/*",
    "https://qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://kimi.com/*",
    "https://*.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://*.kimi.moonshot.cn/*",
    "https://yuanbao.tencent.com/*",
    "https://*.yuanbao.tencent.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://x.com/*",
    "https://claude.ai/*",
    "https://perplexity.ai/*",
    "https://poe.com/*",
    "https://aistudio.google.com/*"
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://doubao.com/*",
        "https://*.doubao.com/*",
        "https://chatglm.cn/*",
        "https://*.chatglm.cn/*",
        "https://tongyi.aliyun.com/*",
        "https://*.tongyi.aliyun.com/*",
        "https://qwen.ai/*",
        "https://*.qwen.ai/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://*.kimi.moonshot.cn/*",
        "https://yuanbao.tencent.com/*",
        "https://*.yuanbao.tencent.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://x.com/*",
        "https://claude.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "src/content/dom.js",
        "src/content/bridge.js",
        "src/lib/pdf.js",
        "src/lib/turndown.js",
        "src/lib/marked.js",
        "src/lib/katex.js",
        "src/lib/zip.js",
        "src/lib/omml.js",
        "src/lib/docx-builder.js",
        "src/content/markdown.js",
        "src/lib/latex-builder.js",
        "src/lib/card-image.js",
        "src/content/metadata.js",
        "src/content/assets-packager.js",
        "src/content/core.js",
        "src/content/platform-base.js",
        "src/content/content.js",
        "src/content/platforms/chatgpt.js",
        "src/content/platforms/gemini.js",
        "src/content/platforms/doubao.js",
        "src/content/platforms/kimi.js",
        "src/content/platforms/chatglm.js",
        "src/content/platforms/tongyi.js",
        "src/content/platforms/qwen.js",
        "src/content/platforms/yuanbao.js",
        "src/content/platforms/grok.js",
        "src/content/platforms/deepseek.js",
        "src/content/platforms/claude.js",
        "src/content/platforms/perplexity.js",
        "src/content/platforms/aistudio.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
